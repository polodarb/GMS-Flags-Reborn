    <!-- Compatibility patches (a signed, targeted runtime patch that goes beyond a plain flag
         override). The end-user word is "patch" - "micro-hook" is internal jargon and never shown. -->
    <string name="suggestions_details_patch_title">Compatibility patch</string>
    <!-- `purpose` is free-form admin text from the backend (not localized), shown verbatim as a
         supporting line. It is never the primary label. -->
    <string name="suggestions_details_patch_note">%1$s</string>
    <string name="suggestions_details_patch_learn_more">What does this mean?</string>

    <!-- Trust states: short chip label + a full description shown in the explainer sheet. -->
    <string name="suggestions_details_patch_trust_sheet_title">Patch protection</string>
    <string name="suggestions_details_patch_trust_sheet_description">A patch can carry a server signature. Before applying one, the app checks that signature against a key built into this version — so a patch can’t be swapped or tampered with on its way to your device.</string>
    <string name="suggestions_details_patch_trust_verified">Protected &amp; verified</string>
    <string name="suggestions_details_patch_trust_verified_desc">Signed by the server and checked against this app’s built-in key. It matched, so this patch is genuine and safe to apply.</string>
    <string name="suggestions_details_patch_trust_not_signed">Not signed</string>
    <string name="suggestions_details_patch_trust_not_signed_desc">This patch doesn’t carry a signature yet, so there’s nothing to check. It applies like any normal recommendation step.</string>
    <string name="suggestions_details_patch_trust_unavailable">Not checked here</string>
    <string name="suggestions_details_patch_trust_unavailable_desc">This build has no verification key, so the signature couldn’t be checked on this device. The patch still applies, but it wasn’t verified here.</string>
    <string name="suggestions_details_patch_trust_failed">Signature mismatch</string>
    <string name="suggestions_details_patch_trust_failed_desc">This patch’s signature does NOT match this app’s built-in key. It may have been tampered with, or the app’s key is out of date. It will not be applied — please contact support.</string>
    <string name="suggestions_details_patch_trust_update_required">Update required</string>
    <string name="suggestions_details_patch_trust_update_required_desc">This patch needs a newer version of GMS Flags than you have. It won’t be applied until you update. Grab the latest release to enable it.</string>
    <string name="suggestions_details_patch_trust_update_button">Download update</string>

    <!-- Failed-verification card (shown inline in place of the normal patch card). -->
    <string name="suggestions_details_patch_failed_title">This patch can’t be trusted</string>
    <string name="suggestions_details_patch_failed_body">Its signature didn’t match, so it won’t be applied. Contact support before continuing.</string>
    <string name="suggestions_details_patch_failed_required">The whole recommendation stays blocked until this is resolved.</string>
    <string name="suggestions_details_patch_failed_optional">This patch is skipped; the rest of the recommendation still applies.</string>

    <!-- App-integrity card (shown inline in place of the normal patch card, for every patch, when
         this APK's own signing certificate doesn't match the official release). Distinct from the
         patch-signature failure above: this is about whether the APP itself is genuine, not the
         patch - a modified app could report any patch as "Verified" regardless of its real
         signature, so per-patch verification alone proves nothing here. Not bypassable. -->
    <string name="suggestions_details_patch_app_untrusted_title">This app build can’t apply patches</string>
    <string name="suggestions_details_patch_app_untrusted_body">This copy of the app doesn’t match the official release signature, so patches are blocked regardless of their own signature — a modified app could fake that check too. Reinstall the official build to apply patches.</string>

    <!-- Block card, alarming variant: a required patch's signature actively FAILED (likely tampered). -->
    <string name="suggestions_details_hook_block_title">Signature mismatch detected</string>
    <string name="suggestions_details_hook_block_message">A required patch in this configuration did not pass signature verification. It has not been applied. This could mean it was tampered with, or that the app’s built-in key is out of date — please contact support before proceeding.</string>
    <!-- Block card, calmer variant: a required patch simply couldn't be verified (unsigned, or this
         build has no key). Still blocked under mandatory signing, but not an alarm. -->
    <string name="suggestions_details_hook_block_unverified_title">Patch couldn’t be verified</string>
    <string name="suggestions_details_hook_block_unverified_message">This recommendation needs a patch that the app couldn’t verify — it isn’t signed, or this build has no key to check it against. To keep you safe it wasn’t applied. If you keep seeing this, contact support.</string>
    <string name="suggestions_details_hook_apply_anyway">Apply anyway</string>
    <string name="suggestions_details_hook_report">Report a problem</string>
    <string name="suggestions_details_hook_confirm_title">Apply an unverified patch?</string>
    <string name="suggestions_details_hook_confirm_message">This patch wasn’t verified by the app — it may be unsigned, or its signature didn’t match. Applying it anyway could let a modified patch change how this app behaves. Continue only if you understand and accept this risk.</string>
    <string name="suggestions_details_hook_confirm_cancel">Cancel</string>
    <string name="suggestions_details_hook_confirm_confirm">Apply anyway</string>

    <!-- "View instructions": a plain-English rendering of exactly what a patch's signed recipe
         says (where it hooks, and under what conditions it changes behavior), decoded on-device.
         Transparency feature - lets anyone inspect a patch instead of trusting it blindly. -->
